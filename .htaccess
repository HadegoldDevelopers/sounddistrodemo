<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect www → non-www (preserve HTTPS)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

    # Forward every request into the public/ directory.
    # Required on cPanel/LiteSpeed hosting where the domain document root is
    # the Laravel project root — public/.htaccess then handles static files
    # and the front controller. The RewriteCond guard prevents a rewrite
    # loop (500 error) when the request is already inside /public/.
    RewriteCond %{REQUEST_URI} !^/public/ [NC]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit